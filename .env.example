# Copy to .env. Every value is optional; with none set the engine reads barcodes and
# printed text only, and says so in `warnings`.

# Bearer token required on /v1/*. Always set it when the engine is reachable from outside localhost.
TASADOR_API_TOKEN=

# --- Vision (what is the item?) --- anthropic | openai-compatible | none | auto
TASADOR_VISION_PROVIDER=auto
ANTHROPIC_API_KEY=
TASADOR_ANTHROPIC_MODEL=claude-opus-5-5
TASADOR_ANTHROPIC_EFFORT=medium
# Local models through any OpenAI-compatible server (Ollama shown; inside docker compose use http://ollama:11434/v1)
TASADOR_OPENAI_BASE_URL=
TASADOR_OPENAI_MODEL=qwen2.5vl:7b
# none = no "thinking" (much faster on small local models). Empty = don't send the field.
TASADOR_OPENAI_REASONING_EFFORT=none
# Photos sent to a local model per request (0 = all). Text and barcodes are read from every photo.
TASADOR_OPENAI_MAX_IMAGES=4

# --- Price search --- anthropic | searxng | none | auto
TASADOR_SEARCH_PROVIDER=auto
# Inside docker compose: http://searxng:8080
TASADOR_SEARXNG_URL=
# Result pages opened per request to confirm the product and read exact prices (0 = off)
TASADOR_VERIFY_PAGES=8

# --- Limits and access ---
TASADOR_ALLOWED_IMAGE_HOSTS=
TASADOR_CORS_ORIGINS=
TASADOR_MAX_IMAGES=8
TASADOR_MAX_CONCURRENCY=2
