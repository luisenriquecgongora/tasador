# Copy to .env. Every value is optional; with none set the engine reads barcodes and
# printed text only, and says so in `warnings`.

# Bearer token required on /v1/*. Leave empty on your own computer (the engine then only
# listens on localhost). Always set it when the engine is reachable by others.
TASADOR_API_TOKEN=

# --- Vision: what is the item? -------------------------------------------------------
# anthropic | openai-compatible | openai | gemini | openrouter | groq | mistral | together
#   | xai | ollama | lmstudio | none | auto
# Every provider except anthropic uses the OpenAI-style /chat/completions API; the named
# presets fill in the base URL. "auto": the base URL below if set, else Anthropic if
# ANTHROPIC_API_KEY is set, else none.
TASADOR_VISION_PROVIDER=auto
# Required for cloud presets. Defaults: claude-opus-5-5 (anthropic), qwen2.5vl:7b (ollama).
TASADOR_VISION_MODEL=
# Only for a server without a preset (vLLM, an internal gateway...).
# Inside docker compose, Ollama is at http://ollama:11434/v1
TASADOR_VISION_BASE_URL=
# The provider's key. For anthropic, ANTHROPIC_API_KEY works too.
TASADOR_VISION_API_KEY=
ANTHROPIC_API_KEY=
# Claude only: low | medium | high | xhigh | max
TASADOR_VISION_EFFORT=medium
# OpenAI-compatible only. Empty = automatic ("none" for local servers, which turns off slow
# "thinking"; not sent to cloud APIs). "off" = never send it.
TASADOR_VISION_REASONING_EFFORT=
# Photos sent to the model per request. 0 = automatic (4 for local servers, all for cloud).
# Barcodes and printed text are read from every photo regardless.
TASADOR_VISION_MAX_IMAGES=0

# --- Web search: links and prices ----------------------------------------------------
# searxng | brave | anthropic | none | auto
# "auto": SearXNG if its URL is set, else Brave if a key is set, else Claude if
# ANTHROPIC_API_KEY is set, else none.
TASADOR_SEARCH_PROVIDER=auto
# SearXNG (self-hosted, no key). Inside docker compose: http://searxng:8080
TASADOR_SEARXNG_URL=
# Brave Search API key (https://api.search.brave.com)
TASADOR_SEARCH_API_KEY=
# Claude model for TASADOR_SEARCH_PROVIDER=anthropic
TASADOR_SEARCH_MODEL=claude-opus-5-5
# Result pages opened per request to confirm the product and read exact prices (0 = off)
TASADOR_VERIFY_PAGES=8

# --- Limits and access ---------------------------------------------------------------
TASADOR_ALLOWED_IMAGE_HOSTS=
# Web origins allowed to call the engine from a browser, e.g. https://app.example.com
TASADOR_CORS_ORIGINS=
TASADOR_MAX_IMAGES=8
TASADOR_MAX_CONCURRENCY=2

# --- Local settings page at http://localhost:8000/ ------------------------------------
# Tasador.bat sets both. Never enable the page on a server.
TASADOR_SETTINGS_UI=
TASADOR_ENV_FILE=
